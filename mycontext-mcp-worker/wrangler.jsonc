{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mycontext-mcp",
  "account_id": "1f7287ca0dc182ac70db5e77dcd5f3ce",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.2
    }
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "88cc0f72224947fc818c0520207164de"
    },
    {
      "binding": "AUTH_KV",
      "id": "3c6429869d7e41b19f3423670f2c1c90"
    }
  ],
  "triggers": {
    "crons": ["17 4 * * *"]
  },
  "secrets": {
    "required": [
      "TIDB_DATABASE_URL",
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "GITHUB_ALLOWED_USER_ID",
      "PERSONAL_SYNONYMS"
    ]
  }
}
